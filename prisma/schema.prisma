// ============================================================
// LOTUS GOLF CENTER — Prisma schema
// PostgreSQL. Lưu timestamp theo UTC (timestamptz).
// Sinh từ mock data + types hiện có trong src/data & src/types.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// RBAC & ADMIN
// ============================================================

model AdminUser {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  fullName     String
  roleId       String
  role         Role          @relation(fields: [roleId], references: [id])
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  sessions     AdminSession[]
  auditLogs    AuditLog[]

  @@index([email])
  @@index([roleId])
}

model Role {
  id          String           @id @default(cuid())
  key         AdminRoleKey     @unique
  name        String
  description String?
  isSystem    Boolean          @default(false) // role hệ thống không xoá được
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  admins      AdminUser[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // ví dụ: "booking.read", "membership.update"
  group       String // ví dụ: "booking", "content"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AdminSession {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // hash của session token (không lưu token thô)
  ip        String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

enum AdminRoleKey {
  SUPER_ADMIN
  ADMIN
  MANAGER
  RECEPTION
  COACH_MANAGER
  MARKETING
  ACCOUNTING
}

// ============================================================
// KHÁCH HÀNG (CRM)
// ============================================================

model Customer {
  id             String     @id @default(cuid())
  fullName       String
  email          String?    @unique
  phone          String     @unique
  avatarInitials String?
  passwordHash      String?
  passwordUpdatedAt DateTime?
  status         CustomerStatus @default(NEW)
  golfLevel      GolfLevel  @default(NEVER)
  handedness     Handedness @default(RIGHT)
  preferredDrink String?
  preferredTime  String?
  preferredCoachId String?
  preferredCoach Coach?     @relation("PreferredCoach", fields: [preferredCoachId], references: [id])
  loyaltyPoints  Int        @default(0)
  walletBalance  Int        @default(0) // đơn vị VND
  internalNote   String?
  joinedAt       DateTime   @default(now())
  lastVisitAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  bookings       Booking[]
  memberships    CustomerMembership[]
  redemptions    VoucherRedemption[]
  eventRegs      EventRegistration[]
  lessons        Lesson[]
  transactions   Transaction[]
  topupRequests  TopupRequest[]
  foodOrders     FoodOrder[]

  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

enum CustomerStatus {
  NEW
  ACTIVE
  VIP
  INACTIVE
  AT_RISK
}

enum GolfLevel {
  NEVER
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Handedness {
  RIGHT
  LEFT
}

// ============================================================
// HUẤN LUYỆN VIÊN
// ============================================================

model Coach {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  title           String
  avatar          String?
  bio             String?
  philosophy      String?
  yearsExperience Int      @default(0)
  specialties     CoachSpecialty[]
  languages       CoachLanguage[]
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  studentCount    Int      @default(0)
  pricePerSession Int      @default(0)
  certifications  String[]
  referralCode    String?  @unique
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  availability    CoachAvailability[]
  bookings        Booking[]
  lessons         Lesson[]
  commissions     Commission[]
  preferredBy     Customer[] @relation("PreferredCoach")

  @@index([slug])
  @@index([isActive])
  @@index([isFeatured, sortOrder])
}

model CoachAvailability {
  id        String   @id @default(cuid())
  coachId   String
  coach     Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  time      String // HH:mm
  status    SlotAvailability @default(OPEN)
  bookingId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([coachId, date, time])
  @@index([date])
  @@index([status])
}

enum SlotAvailability {
  OPEN
  BLOCKED
  BOOKED
  LEAVE
}

enum CoachSpecialty {
  BEGINNER
  JUNIOR
  ADVANCED
  PUTTING
  SWING
  SHORT_GAME
  COMPETITION
  BUSINESS
}

enum CoachLanguage {
  VI
  EN
  KO
  JA
}

// ============================================================
// KHU VỰC SÂN & TRẢI NGHIỆM
// ============================================================

model PracticeZone {
  id          String    @id @default(cuid())
  key         String    @unique // driving-range, putting-green...
  name        String
  description String?
  image       String?
  capacityNote String?
  surcharge   Int       @default(0)
  features    String[]
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  bookings    Booking[]
}

model Experience {
  id           String   @id @default(cuid())
  slug         String   @unique
  key          String   @unique // range, coaching, putting... (loại booking)
  name         String
  category     String?
  description  String?
  longDescription String?
  images       String[]
  basePrice    Int      @default(0)
  durationMinutes Int   @default(60)
  minGuests    Int      @default(1)
  maxGuests    Int      @default(20)
  includes     String[]
  excludes     String[]
  suggestedZoneKey String?
  requiresCoach Boolean @default(false)
  isActive     Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
  bookings     Booking[]

  @@index([slug])
  @@index([isActive])
}

model AddOn {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  price       Int      @default(0)
  unit        String?
  max         Int      @default(10)
  icon        String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  bookingItems BookingItem[]
}

// ============================================================
// BOOKING
// ============================================================

model Booking {
  id             String        @id @default(cuid())
  code           String        @unique
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  contactName    String
  contactPhone   String
  contactEmail   String?
  note           String?
  experienceId   String?
  experience     Experience?   @relation(fields: [experienceId], references: [id])
  experienceLabel String
  coachId        String?
  coach          Coach?        @relation(fields: [coachId], references: [id])
  zoneId         String?
  zone           PracticeZone? @relation(fields: [zoneId], references: [id])
  zoneName       String?
  date           DateTime      @db.Date
  time           String // HH:mm
  durationMinutes Int          @default(60)
  guests         Int           @default(1)
  voucherCode    String?
  source         BookingSource @default(ONLINE)
  status         BookingStatus @default(PENDING)
  paymentMethod  PaymentMethod @default(AT_CENTER)
  paymentStatus  PaymentStatus @default(UNPAID)

  // Bảng giá (snapshot tại thời điểm đặt)
  basePriceAmount     Int @default(0)
  zoneSurchargeAmount Int @default(0)
  coachFeeAmount      Int @default(0)
  addOnsAmount        Int @default(0)
  subtotalAmount      Int @default(0)
  membershipDiscount  Int @default(0)
  voucherDiscount     Int @default(0)
  walletApplied       Int @default(0)
  totalAmount         Int @default(0)

  qrPayload      String?
  staffNote      String?
  checkedInAt    DateTime?
  checkedInById  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  items          BookingItem[]
  statusHistory  BookingStatusHistory[]

  @@index([date])
  @@index([status])
  @@index([paymentStatus])
  @@index([customerId])
  @@index([coachId])
  @@index([createdAt])
  @@index([code])
}

model BookingItem {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOnId   String?
  addOn     AddOn?   @relation(fields: [addOnId], references: [id])
  name      String
  quantity  Int      @default(1)
  unitPrice Int      @default(0)

  @@index([bookingId])
}

model BookingStatusHistory {
  id        String        @id @default(cuid())
  bookingId String
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus BookingStatus?
  toStatus  BookingStatus
  note      String?
  changedById String?
  createdAt DateTime      @default(now())

  @@index([bookingId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  ONLINE
  PHONE
  WALK_IN
  ADMIN
}

enum PaymentMethod {
  WALLET
  MOMO
  VNPAY
  CARD
  TRANSFER
  AT_CENTER
}

enum PaymentStatus {
  UNPAID
  PAID_AT_COUNTER
  PAID
  REFUNDED
}

// ============================================================
// MEMBERSHIP
// ============================================================

model MembershipPlan {
  id                   String   @id @default(cuid())
  key                  String   @unique // starter, member, premium, founder
  name                 String
  slug                 String   @unique
  tagline              String?
  description          String?
  price                Int      @default(0) // giá gói / top-up
  bonusPercent         Int      @default(0)
  courtDiscountPercent Int      @default(0)
  coachDiscountPercent Int      @default(0)
  fnbDiscountPercent   Int      @default(0)
  durationMonths       Int      @default(12)
  advanceBookingDays   Int      @default(0)
  benefits             Json?
  isActive             Boolean  @default(true)
  isFeatured           Boolean  @default(false)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deletedAt            DateTime?

  customers            CustomerMembership[]
  history              MembershipPlanHistory[]

  @@index([isActive])
}

model MembershipPlanHistory {
  id         String   @id @default(cuid())
  planId     String
  plan       MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  changedById String?
  snapshot   Json // ảnh chụp giá/quyền lợi tại thời điểm đổi
  createdAt  DateTime @default(now())

  @@index([planId])
}

model CustomerMembership {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  planId      String
  plan        MembershipPlan @relation(fields: [planId], references: [id])
  purchasedAt DateTime @default(now())
  expiresAt   DateTime
  topUpAmount Int      @default(0)
  bonusAmount Int      @default(0)
  isActive    Boolean  @default(true)

  @@index([customerId])
  @@index([expiresAt])
}

// ============================================================
// VOUCHER
// ============================================================

model Voucher {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String?
  category      String?
  discountType  VoucherDiscountType @default(PERCENT)
  discountValue Int      @default(0)
  maxDiscount   Int?
  minOrder      Int      @default(0)
  startAt       DateTime?
  endAt         DateTime?
  totalQuantity Int      @default(0)
  usageLimit    Int?
  perUserLimit  Int?
  memberOnly    Boolean  @default(false)
  status        VoucherStatus @default(DRAFT)
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  redemptions   VoucherRedemption[]

  @@index([code])
  @@index([status])
}

model VoucherRedemption {
  id         String   @id @default(cuid())
  voucherId  String
  voucher    Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  bookingCode String?
  discountAmount Int   @default(0)
  createdAt  DateTime @default(now())

  @@index([voucherId])
  @@index([customerId])
}

enum VoucherDiscountType {
  PERCENT
  AMOUNT
}

enum VoucherStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

// ============================================================
// SỰ KIỆN
// ============================================================

model Event {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  type          String?
  summary       String?
  description   String?
  banner        String?
  gallery       String[]
  startsAt      DateTime
  endsAt        DateTime?
  location      String?
  fee           Int      @default(0)
  capacity      Int      @default(0)
  registrationDeadline DateTime?
  benefits      String[]
  rules         String[]
  sponsors      String[]
  isPublished   Boolean  @default(false)
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  registrations EventRegistration[]

  @@index([slug])
  @@index([isPublished])
  @@index([startsAt])
}

model EventRegistration {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  contactName  String
  contactPhone String?
  contactEmail String?
  attendees    Int      @default(1)
  fee          Int      @default(0)
  status       RegistrationStatus @default(REGISTERED)
  checkedInAt  DateTime?
  qrPayload    String?
  createdAt    DateTime @default(now())

  @@index([eventId])
  @@index([status])
}

enum RegistrationStatus {
  REGISTERED
  CHECKED_IN
  CANCELLED
  NO_SHOW
}

// ============================================================
// ACADEMY
// ============================================================

model AcademyProgram {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  level        String?
  audience     String?
  summary      String?
  curriculum   Json?
  sessions     Int      @default(1)
  durationMinutes Int   @default(60)
  priceFrom    Int      @default(0)
  groupSize    String?
  image        String?
  icon         String?
  isActive     Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([isActive])
}

model Lesson {
  id            String   @id @default(cuid())
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  coachId       String?
  coach         Coach?   @relation(fields: [coachId], references: [id])
  programName   String?
  date          DateTime @db.Date
  time          String
  status        LessonStatus @default(SCHEDULED)
  focus         String?
  coachNote     String?
  homework      String?
  progressScore Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([customerId])
  @@index([coachId])
  @@index([date])
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// ============================================================
// F&B
// ============================================================

model FoodCategory {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  products  FoodProduct[]
}

model FoodProduct {
  id          String   @id @default(cuid())
  categoryId  String
  category    FoodCategory @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  price       Int      @default(0)
  image       String?
  partner     String?
  calories    Int?
  tags        String[]
  isAvailable Boolean  @default(true)
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  orderItems  FoodOrderItem[]

  @@index([categoryId])
  @@index([isActive])
}

model FoodOrder {
  id             String   @id @default(cuid())
  code           String   @unique
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  total          Int      @default(0)
  deliveryTarget String?
  bayNumber      String?
  scheduledTime  String?
  note           String?
  status         FoodOrderStatus @default(PREPARING)
  createdAt      DateTime @default(now())
  items          FoodOrderItem[]

  @@index([customerId])
  @@index([status])
}

model FoodOrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   FoodProduct? @relation(fields: [productId], references: [id])
  name      String
  quantity  Int      @default(1)
  price     Int      @default(0)

  @@index([orderId])
}

enum FoodOrderStatus {
  PREPARING
  DELIVERED
  CANCELLED
}

// ============================================================
// LEADS: CORPORATE / TOUR / PARTNER
// ============================================================

model CorporateLead {
  id           String   @id @default(cuid())
  company      String?
  contactName  String
  contactPhone String?
  contactEmail String?
  guests       Int?
  requestedDate DateTime?
  budget       Int?
  packageName  String?
  status       PipelineStatus @default(NEW)
  assignedToId String?
  note         String?
  payload      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model TourLead {
  id           String   @id @default(cuid())
  agency       String?
  contactName  String
  contactPhone String?
  contactEmail String?
  guests       Int?
  requestedDate DateTime?
  packageName  String?
  status       PipelineStatus @default(NEW)
  note         String?
  payload      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

// Yêu cầu chung từ các form public: liên hệ, doanh nghiệp, tour đoàn, đại lý.
model Lead {
  id        String   @id @default(cuid())
  type      String // contact | corporate | tour-group | agency
  summary   String
  name      String?
  phone     String?
  email     String?
  payload   Json?
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([handled])
  @@index([createdAt])
}

// Bài viết Thư Viện (blog) — admin tự đăng/sửa.
model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  summary     String?
  content     String    @db.Text
  coverImage  String?
  category    String?
  author      String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished])
  @@index([slug])
  @@index([publishedAt])
}

// Ảnh do admin tải lên (lưu trực tiếp trong DB để không mất khi redeploy).
model ImageBlob {
  id        String   @id @default(cuid())
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  type        String?
  contactName String?
  contactPhone String?
  contactEmail String?
  note        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum PipelineStatus {
  NEW
  CONTACTED
  PROPOSAL
  NEGOTIATING
  CONFIRMED
  COMPLETED
  LOST
}

// ============================================================
// CMS: NỘI DUNG WEBSITE
// ============================================================

model ContentPage {
  id        String   @id @default(cuid())
  key       String   @unique // HOME, ABOUT, CONTACT...
  title     String
  isPublished Boolean @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  sections  ContentSection[]
}

model ContentSection {
  id        String   @id @default(cuid())
  pageId    String
  page      ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key       String // hero, trust-bar, experiences...
  label     String
  data      Json // nội dung có cấu trúc (title, subtitle, image, cta...)
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([pageId, key])
  @@index([pageId])
}

model Testimonial {
  id         String   @id @default(cuid())
  authorName String
  authorTitle String?
  avatar     String?
  content    String
  rating     Int      @default(5)
  isFeatured Boolean  @default(false)
  isVisible  Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  key       String?  @unique // khớp id trong data mock (vd: beginner-1) để Admin ghi đè
  category  String?
  question  String
  answer    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model NavItem {
  id        String   @id @default(cuid())
  location  String // header, footer
  label     String
  href      String
  parentId  String?
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)

  @@index([location])
}

// ============================================================
// MEDIA
// ============================================================

model Media {
  id        String   @id @default(cuid())
  fileName  String
  url       String
  altText   String?
  mimeType  String?
  type      MediaType @default(IMAGE)
  size      Int      @default(0)
  createdById String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

// ============================================================
// SETTINGS & SEO
// ============================================================

model SiteSetting {
  id        String   @id @default(cuid())
  group     String // general, social, booking, contact, seo
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@index([group])
}

model SeoSetting {
  id             String   @id @default(cuid())
  targetType     String // page, experience, coach, event, academy
  targetKey      String // slug hoặc key của đối tượng
  metaTitle      String?
  metaDescription String?
  ogImage        String?
  canonical      String?
  noindex        Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  @@unique([targetType, targetKey])
}

// ============================================================
// FINANCE
// ============================================================

model Transaction {
  id          String   @id @default(cuid())
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  type        TransactionType
  label       String
  amount      Int // dương = thu, âm = chi
  balanceAfter Int?
  reference   String?
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@index([type])
  @@index([createdAt])
}

model Commission {
  id             String   @id @default(cuid())
  coachId        String
  coach          Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  source         String // lesson, referral, package, event
  label          String
  grossAmount    Int      @default(0)
  commissionAmount Int    @default(0)
  status         CommissionStatus @default(PENDING)
  date           DateTime @db.Date
  createdAt      DateTime @default(now())

  @@index([coachId])
  @@index([status])
}

enum TransactionType {
  TOPUP
  BONUS
  PAYMENT
  REFUND
  VOUCHER_PURCHASE
  COMMISSION
}

enum TopupStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// Yêu cầu nạp ví: khách khai đã chuyển khoản -> Admin xác nhận -> ví mới cộng tiền.
model TopupRequest {
  id           String      @id @default(cuid())
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount       Int
  status       TopupStatus @default(PENDING)
  transferNote String // nội dung chuyển khoản (mã đối soát)
  customerNote String?
  reviewedBy   String? // email admin đã xử lý
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

enum CommissionStatus {
  PENDING
  CONFIRMED
  PAID
}

// ============================================================
// NOTIFICATION & AUDIT
// ============================================================

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  admin      AdminUser? @relation(fields: [adminId], references: [id])
  action     String // LOGIN, CREATE, UPDATE, DELETE, RESTORE...
  entity     String // Booking, MembershipPlan...
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([entity])
  @@index([createdAt])
}
