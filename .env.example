# ============================================================
# LOTUS GOLF CENTER — Biến môi trường
# Sao chép file này thành .env.local rồi điền giá trị thật.
# KHÔNG commit .env.local lên GitHub.
# ============================================================

# URL công khai của site (dùng cho metadataBase, sitemap, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Thông tin liên hệ hiển thị trên website
NEXT_PUBLIC_HOTLINE=1900 1990
NEXT_PUBLIC_CONTACT_EMAIL=hello@lotusgolf.vn
NEXT_PUBLIC_ZALO_URL=https://zalo.me/lotusgolf

# Cổng chạy ứng dụng ở môi trường production (Hostinger sẽ inject PORT)
PORT=3000

# ------------------------------------------------------------
# GIAI ĐOẠN SAU — chưa dùng ở bản frontend demo hiện tại
