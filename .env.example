# ============================================================
# LOTUS GOLF CENTER — Biến môi trường
# Sao chép file này thành .env.local (dev) hoặc cấu hình trên Hostinger (prod).
# KHÔNG commit .env / .env.local lên GitHub.
# ============================================================

# ---- Public site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_HOTLINE=1900 1990
NEXT_PUBLIC_CONTACT_EMAIL=hello@lotusgolf.vn
NEXT_PUBLIC_ZALO_URL=https://zalo.me/lotusgolf
PORT=3000

# ---- Timezone (báo cáo & booking hiển thị theo giờ này) ----
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ============================================================
# DATABASE (PostgreSQL) — bắt buộc cho Admin/CMS
# Dùng Postgres của Hostinger hoặc nhà cung cấp ngoài
# (Neon, Supabase, Railway...). Chuỗi kết nối chuẩn PostgreSQL.
# ============================================================
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/lotus?schema=public&sslmode=require

# ============================================================
# ADMIN AUTHENTICATION
# ============================================================
# Bí mật ký session (JWT). Sinh chuỗi ngẫu nhiên >= 32 ký tự:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=change-me-to-a-long-random-secret
# Thời hạn session (giây). Mặc định 8 giờ.
ADMIN_SESSION_TTL=28800

# ---- Khởi tạo SUPER ADMIN lần đầu (dùng cho: npm run create-admin) ----
# KHÔNG commit giá trị thật. Chỉ dùng để tạo tài khoản đầu tiên.
SUPER_ADMIN_EMAIL=admin@lotusgolf.vn
SUPER_ADMIN_PASSWORD=change-this-strong-password
SUPER_ADMIN_NAME=Super Admin

# ============================================================
# MEDIA STORAGE (Media Library)
# Mặc định lưu file vào /public/uploads. Production nên dùng
# object storage (S3 tương thích) để bền vững qua các lần deploy.
# ============================================================
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_DIR=public/uploads
MEDIA_PUBLIC_BASE_URL=/uploads
# S3-compatible (khi MEDIA_STORAGE_DRIVER=s3)
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# ============================================================
# GIAI ĐOẠN SAU — chưa dùng
# ============================================================
# PAYMENT_PUBLIC_KEY=
# ZALO_OA_TOKEN=
